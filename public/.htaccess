# =====================================================================
#  Yeni Vizyon Yapı — sunucu ayarları (LiteSpeed / Apache uyumlu)
#  Bu dosya projedeki public/.htaccess dosyasından gelir ve her deploy'da
#  yeniden yüklenir. Sunucuda elle değiştirmeyin; projede değiştirin.
# =====================================================================

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8

# ---------------------------------------------------------------------
# 1) Tek adres: her şey https://yenivizyonyapi.com adresine 301 ile gider
#    (http -> https ve www -> www'suz). Google tek site görür.
# ---------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Let's Encrypt / SSL doğrulamasına dokunma
  RewriteRule ^\.well-known/ - [L]

  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://yenivizyonyapi.com%{REQUEST_URI} [R=301,L,NE]

  # index.html'i adreste gösterme: /index.html -> /, /katalog/index.html -> /katalog/
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /%1 [R=301,L,NE]

  # Eski adresler (eski site sürümündeki dosyalar) -> yeni karşılıkları
  RewriteRule ^images/logoo-removebg-preview\.(png|ico)$ /images/logo.png [R=301,L]
</IfModule>

# ---------------------------------------------------------------------
# 2) Gizli / gereksiz dosyalara erişimi kapat
#    (deploy kayıt dosyaları, dotfile'lar, kaynak harita dosyaları)
# ---------------------------------------------------------------------
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<FilesMatch "\.(map|json|md|lock|ts|tsx|yml|yaml)$">
  Require all denied
</FilesMatch>
<Files "site.webmanifest">
  Require all granted
</Files>

# ---------------------------------------------------------------------
# 3) Hata sayfası
# ---------------------------------------------------------------------
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------
# 4) Dosya türleri
# ---------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
  AddType application/javascript .js .mjs
  AddCharset UTF-8 .html .css .js .xml .txt .webmanifest .svg
</IfModule>

# ---------------------------------------------------------------------
# 5) Sıkıştırma (sayfa hızı = SEO)
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# ---------------------------------------------------------------------
# 6) Tarayıcı önbelleği
#    - assets/ içindeki dosyaların adı her derlemede değişir -> 1 yıl
#    - fotoğraflar ve ikonlar -> 30 gün
#    - HTML, robots, sitemap -> her seferinde kontrol et (güncellemeler hemen görünür)
# ---------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/plain "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType image/vnd.microsoft.icon "access plus 30 days"
  ExpiresByType application/pdf "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Güvenlik başlıkları
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  # Tarayıcılar 1 yıl boyunca siteyi yalnızca https ile açar
  Header always set Strict-Transport-Security "max-age=31536000"

  # PDF katalog tarayıcıda açılsın, kaydedilirken düzgün ad alsın
  <Files "yeni-vizyon-yapi-katalog.pdf">
    Header set Content-Disposition "inline; filename=\"yeni-vizyon-yapi-katalog.pdf\""
  </Files>
</IfModule>
